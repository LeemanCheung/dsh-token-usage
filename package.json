{
  "name": "dsh-token-usage",
  "version": "0.3.2",
  "private": true,
  "description": "Persistent token usage records and dashboard for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "token-usage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LeemanCheung/dsh-token-usage.git"
  },
  "bugs": {
    "url": "https://github.com/LeemanCheung/dsh-token-usage/issues"
  },
  "homepage": "https://github.com/LeemanCheung/dsh-token-usage#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "pluginType": "feature",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1 <0.2.0",
      "dshReleases": {
        "0.1.2-rc.1": "unknown"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:config": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2024 --skipLibCheck --allowImportingTsExtensions --types node tsdown.config.ts tests/build-config.spec.ts",
    "typecheck": "npm run typecheck:host && npm run typecheck:client && npm run typecheck:config",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-retry": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  }
}
